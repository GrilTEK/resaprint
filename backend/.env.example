# Core
SECRET_KEY=change-me-to-a-long-random-value
SESSION_COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=43200
PIN_LOCKOUT_THRESHOLD=5
PIN_LOCKOUT_MINUTES=15

# Database (docker-compose sets this to the `db` service by default).
# POSTGRES_PASSWORD must match the password in DATABASE_URL — compose
# uses it to initialize the `db` container's superuser password.
DATABASE_URL=postgresql+asyncpg://resaprint:resaprint@db:5432/resaprint
POSTGRES_USER=resaprint
POSTGRES_PASSWORD=resaprint
POSTGRES_DB=resaprint

# IMAP ingestion — dedicated mailbox for incoming reservation emails
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=reservations@example.com
IMAP_PASSWORD=change-me
IMAP_FOLDER=INBOX
IMAP_PROCESSED_FOLDER=Processed
IMAP_POLL_SECONDS=60

# Printing
LAN_PRINT_TIMEOUT_SECONDS=5.0
