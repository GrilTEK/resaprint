<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ResaPrint.Installer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ResaPrint.Installer</AssemblyName>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResaPrint.Shared\ResaPrint.Shared.csproj" />
  </ItemGroup>

  <!--
    ResaPrint.Agent.exe and ResaPrint.Tray.exe get embedded directly
    into this installer's assembly, so the release ships exactly one
    file (see .github/workflows/client-release.yml, which publishes
    those two projects first and stages their output here as
    Payload\*.exe before publishing this project). The wildcard means
    a plain local `dotnet build`/`dotnet publish` without that staging
    step (e.g. client-ci) still succeeds — it just produces an
    installer with nothing to extract, which is fine since nothing
    exercises that path in CI.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Payload\*.exe">
      <LogicalName>ResaPrint.Installer.Payload.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
